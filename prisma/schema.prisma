// Prisma schema — voir https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Reservation {
  id      String @id @default(cuid())
  fullName String
  email    String
  phone    String
  guests   Int
  eventType String
  startDate DateTime
  endDate   DateTime
  message   String?

  // pending -> en attente de réponse du propriétaire
  // confirmed -> approuvée, lien de paiement envoyé
  // paid -> payée (acompte ou totalité)
  // cancelled -> refusée / annulée
  status String @default("pending")

  totalPriceCents   Int
  depositCents       Int?
  paymentCheckoutId   String?
  paymentUrl          String?
  paidAt              DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([startDate, endDate])
}
